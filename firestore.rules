rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se está autenticado
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Função para verificar se é admin
    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Função para verificar se é treinador
    function isTreinador() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'treinador';
    }

    // Users - só admin pode escrever, todos autenticados podem ler
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Atletas - treinadores podem ler e escrever da sua equipa, admin tudo
    match /atletas/{atletaId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isTreinador();
      allow delete: if isAdmin();
    }

    // Treinos - treinadores podem gerir da sua equipa, admin tudo
    match /treinos/{treinoId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isTreinador();
      allow delete: if isAdmin();
    }

    // Avaliações de treino - treinadores podem criar/editar suas avaliações
    match /avaliacoes_treino/{avaliacaoId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isTreinador();
      allow delete: if isAdmin();
    }

    // Presenças - treinadores podem gerir
    match /presencas/{presencaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTreinador();
    }

    // Equipamentos - admin e treinador podem gerir
    match /equipamentos/{equipamentoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTreinador();
    }

    // Quotas - admin gere, todos veem
    match /quotas/{quotaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Comunicados - admin cria, todos leem
    match /comunicados/{comunicadoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Captações - admin e treinador podem gerir
    match /captacoes/{captacaoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTreinador();
    }

    // Escalões - todos podem ler, admin escreve
    match /escaloes/{escalaoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Fisioterapia/episodios - admin e treinador podem gerir
    match /episodios_clinicos/{episodioId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTreinador();
    }
  }
}
